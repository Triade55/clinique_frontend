---
interface KpiItem {
  icon: string;
  title: string;
  desc: string;
}

// Image architecturale intérieure de la clinique (ressource Stitch)
const heroImageUrl = "/images/hero-bg.jpg";

const kpis: KpiItem[] = [
  {
    icon: 'domain_verification',
    title: '7 Spécialités',
    desc: 'Prise en charge multidisciplinaire',
  },
  {
    icon: 'badge',
    title: 'Équipe Experte',
    desc: 'Praticiens chevronnés & urgentistes',
  },
  {
    icon: 'encrypted',
    title: 'Suivi Digitalisé',
    desc: 'Dossier médical chiffré & réactif',
  },
];
---

<section
  id="hero"
  class="relative min-h-screen flex items-center justify-center pt-28 pb-16 px-4 md:px-8 overflow-hidden bg-cover bg-center bg-no-repeat bg-[#F8FAFC] dark:bg-slate-900 transition-colors duration-300"
  style={`background-image: url('${heroImageUrl}');`}
>
  <!-- Background video (Remotion rendered ambient loop) -->
  <video
    autoplay
    loop
    muted
    playsinline
    class="absolute inset-0 w-full h-full object-cover z-0 opacity-40 dark:opacity-30 pointer-events-none transition-opacity duration-700"
    poster={heroImageUrl}
  >
    <source src="/videos/hero-ambient.mp4" type="video/mp4" />
  </video>

  <!-- Background gradient overlay: subtly preserves readability while letting the architectural photo shine through -->
  <div class="absolute inset-0 z-0 bg-gradient-to-t from-[#F8FAFC] via-[#F8FAFC]/80 to-[#F8FAFC]/65 dark:from-slate-900 dark:via-slate-900/85 dark:to-slate-900/70 transition-colors duration-300 pointer-events-none"></div>

  <!-- Animated Ambient Glowing Blobs -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] glow-cyan-blob rounded-full pointer-events-none opacity-50 dark:opacity-25 animate-pulse-glow z-0"></div>
  <div class="absolute top-1/3 right-10 w-[450px] h-[350px] glow-cyan-blob rounded-full pointer-events-none opacity-30 dark:opacity-15 animate-float-slow z-0"></div>

  <div class="relative z-10 max-w-7xl mx-auto w-full flex flex-col items-center text-center mt-8 md:mt-12">
    <!-- Geological Geotag & Status Pill -->
    <div class="reveal inline-flex items-center gap-2.5 px-4 py-2 rounded-full glass-card-light mb-8 text-[#0A2540] dark:text-slate-200 shadow-sm border border-[#c6f7ff] dark:border-cyan-900/40 hover:scale-105 transition-transform duration-300">
      <span class="text-xs sm:text-sm font-semibold flex items-center gap-2">
        📍 Yopougon, Niangon Sud à gauche — Rue Awa SANOGO
      </span>
      <span class="text-slate-300 dark:text-slate-700">|</span>
      <div class="flex items-center gap-1.5 font-bold text-xs text-emerald-700 dark:text-emerald-400">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Urgences 24h/7j</span>
      </div>
    </div>

    <!-- Monumental H1 in Deep Navy / Pure White -->
    <h1 class="reveal stagger-1 font-headline font-extrabold text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-[#0A2540] dark:text-white max-w-5xl tracking-tight mb-6 drop-shadow-sm">
      L'excellence médicale au cœur de Yopougon.
    </h1>

    <!-- Subtitle explicitly highlighting 7 specialties & location -->
    <p class="reveal stagger-2 font-body text-base md:text-xl text-[#475569] dark:text-slate-300 max-w-3xl mb-10 leading-relaxed font-normal">
      7 pôles de pointe à votre service : <strong class="text-[#0A2540] dark:text-cyan-300 font-semibold">Médecine générale, Cardiologie, Pédiatrie, Maternité, Dentaire, Ophtalmologie et Psychiatrie</strong>. Situé Rue Awa SANOGO, bénéficiez d'un plateau technique moderne et d'un suivi patient 100% digitalisé.
    </p>

    <!-- CTA Action Cluster -->
    <div class="reveal stagger-3 flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto mb-16">
      <a
        class="w-full sm:w-auto px-8 py-4 rounded-full bg-[#c6f7ff] dark:bg-cyan-400 hover:bg-[#b0f2fd] dark:hover:bg-cyan-300 text-[#0A2540] dark:text-slate-950 font-bold text-base md:text-lg flex items-center justify-center gap-3 shadow-md hover:shadow-cyan-300/50 hover:scale-105 active:scale-95 transition-all duration-300 border border-cyan-200 dark:border-cyan-300 group cursor-pointer focus-visible:ring-2 focus-visible:ring-cyan-400 focus-visible:outline-none"
        href="#portail"
        data-open-booking-modal
      >
        <span>Prise de RDV</span>
        <span class="material-symbols-outlined text-[20px] group-hover:translate-x-1.5 transition-transform duration-200" data-icon="arrow_forward">arrow_forward</span>
      </a>
      <a
        class="w-full sm:w-auto px-8 py-4 rounded-full bg-white/90 dark:bg-slate-800 hover:bg-white dark:hover:bg-slate-700 text-[#0A2540] dark:text-white font-bold text-base md:text-lg flex items-center justify-center gap-3 transition-all duration-300 border border-[#c6f7ff] dark:border-cyan-900/50 shadow-sm hover:shadow-md hover:scale-105 active:scale-95"
        href="tel:+2250768280690"
      >
        <span class="material-symbols-outlined text-rose-500 text-[22px] animate-pulse" data-icon="phone_in_talk">phone_in_talk</span>
        <span>Appelez-nous</span>
      </a>
    </div>

    <!-- 3 Floating KPI Cards at bottom of Hero -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 w-full max-w-4xl text-left">
      {kpis.map((kpi, idx) => (
        <div class={`reveal-scale stagger-${idx + 3} glass-card-light card-hover-effect shimmer-card p-6 rounded-2xl flex items-center gap-4 border border-[#c6f7ff] dark:border-cyan-900/40 hover:border-cyan-300 dark:hover:border-cyan-500 group`}>
          <div class="w-12 h-12 rounded-xl bg-[#e8fbff] dark:bg-slate-800 border border-[#c6f7ff] dark:border-cyan-900/50 flex items-center justify-center text-[#0A2540] dark:text-cyan-300 group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
            <span class="material-symbols-outlined text-[26px]" data-icon={kpi.icon}>{kpi.icon}</span>
          </div>
          <div>
            <div class="font-headline text-xl text-[#0A2540] dark:text-white font-bold group-hover:text-cyan-700 dark:group-hover:text-cyan-300 transition-colors">{kpi.title}</div>
            <div class="font-body text-xs text-slate-500 dark:text-slate-400">{kpi.desc}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
