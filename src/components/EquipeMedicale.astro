---
// Medical Team & Practitioners Showcase
// According to medical UX: humanizing care drastically improves trust and reduces anxiety
interface Praticien {
  nom: string;
  role: string;
  specialite: string;
  experience: string;
  badge: string;
  icon: string;
  initials: string;
  accentColor: string;
  description: string;
  image: string;
}

const medecins: Praticien[] = [
  {
    nom: 'Dr. Jean-Marc Kouamé',
    role: 'Médecin Chef & Urgentiste',
    specialite: 'Médecine Générale',
    experience: '16 ans d\'expérience • Ancien interne CHU',
    badge: 'Urgences & Médecine Interne',
    icon: 'clinical_notes',
    initials: 'JK',
    accentColor: 'from-cyan-500 to-blue-600',
    description: 'Expert en diagnostic rapide, régulation des urgences et coordination des protocoles de soins.',
    image: '/images/docteurs/dr-kouame.jpg',
  },
  {
    nom: 'Dr. Aminata Touré',
    role: 'Chef de Maternité & Chirurgie Obstétricale',
    specialite: 'Maternité',
    experience: '12 ans d\'expérience • Diplômée Paris-Saclay',
    badge: 'Suivi Naissance Sérénité',
    icon: 'pregnant_woman',
    initials: 'AT',
    accentColor: 'from-pink-500 to-rose-600',
    description: 'Accompagnement bienveillant de la grossesse, monitoring fœtal sans fil et césariennes programmées.',
    image: '/images/docteurs/dr-toure.jpg',
  },
  {
    nom: 'Dr. Eric Brou',
    role: 'Cardiologue & Échographiste Vasculaire',
    specialite: 'Cardiologie',
    experience: '14 ans d\'expérience • Membre Société Africaine de Cardiologie',
    badge: 'Écho 4D & Bilan Ischémique',
    icon: 'cardiology',
    initials: 'EB',
    accentColor: 'from-rose-500 to-red-600',
    description: 'Bilan complet de l\'hypertension, épreuves d\'effort, pose de holters et suivi cardiovasculaire préventif.',
    image: '/images/docteurs/dr-brou.jpg',
  },
  {
    nom: 'Dr. Sarah N\'Goran',
    role: 'Pédiatre & Spécialiste Néonatalogie',
    specialite: 'Pédiatrie',
    experience: '10 ans d\'expérience • Praticienne Référente Yopougon',
    badge: 'Développement & Vaccinologie',
    icon: 'child_care',
    initials: 'SN',
    accentColor: 'from-amber-500 to-orange-600',
    description: 'Soins néonataux délicats, dépistage précoce des troubles de croissance et urgences infantiles douces.',
    image: '/images/docteurs/dr-ngoran.jpg',
  },
];
---

<section class="py-24 px-4 md:px-8 max-w-7xl mx-auto" id="equipe-medicale">
  <div class="text-center max-w-3xl mx-auto mb-16">
    <div class="reveal inline-flex items-center gap-2 px-3 py-1 rounded-full badge-cyan text-xs font-bold uppercase tracking-wider mb-3 hover:scale-105 transition-transform">
      <span class="material-symbols-outlined text-[14px]">badge</span>
      CORPS MÉDICAL PERMANENT
    </div>
    <h2 class="reveal stagger-1 font-headline text-3xl md:text-5xl text-[#0A2540] dark:text-white font-extrabold tracking-tight mb-4">
      Des Médecins Engagés à vos Côtés
    </h2>
    <p class="reveal stagger-2 font-body text-base md:text-lg text-slate-600 dark:text-slate-300">
      Une équipe pluridisciplinaire d'excellence, inscrite à l'Ordre National des Médecins de Côte d'Ivoire, disponible 24h/24 pour votre santé.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {medecins.map((doc, idx) => (
      <div class={`reveal-scale stagger-${idx + 1} glass-card-light card-hover-effect shimmer-card rounded-3xl p-6 flex flex-col justify-between border border-[#c6f7ff] dark:border-cyan-900/40 hover:border-cyan-400 dark:hover:border-cyan-500 hover:shadow-2xl transition-all group`}>
        <div>
          <!-- Doctor Portrait / Avatar Frame -->
          <div class="relative w-full aspect-square rounded-2xl overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700/80 mb-5 group-hover:scale-[1.02] transition-transform duration-300">
            <img
              src={doc.image}
              alt={doc.nom}
              class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />

            <!-- Verified Badge Chip -->
            <div class="absolute bottom-3 inset-x-3 py-1 px-2.5 rounded-full bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border border-[#c6f7ff] dark:border-cyan-900/60 flex items-center justify-between text-[11px] shadow-sm">
              <span class="flex items-center gap-1 font-semibold text-[#0A2540] dark:text-cyan-300">
                <span class="material-symbols-outlined text-emerald-500 text-[14px]">verified</span>
                ONMCI Certifié
              </span>
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            </div>
          </div>

          <!-- Badges & Role -->
          <div class="space-y-2 mb-4">
            <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-cyan-800 dark:text-cyan-300 bg-[#e8fbff] dark:bg-cyan-950/70 border border-cyan-200 dark:border-cyan-800/80 px-2.5 py-0.5 rounded-full">
              {doc.badge}
            </span>
            <h3 class="font-headline text-lg font-bold text-[#0A2540] dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-300 transition-colors">
              {doc.nom}
            </h3>
            <p class="font-headline text-xs font-semibold text-slate-500 dark:text-slate-400">
              {doc.role}
            </p>
          </div>

          <p class="font-body text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
            {doc.description}
          </p>
        </div>

        <div class="pt-4 border-t border-slate-200/80 dark:border-slate-800 flex flex-col gap-2.5">
          <div class="text-[11px] font-medium text-slate-500 dark:text-slate-400 flex items-center gap-1">
            <span class="material-symbols-outlined text-[15px] text-cyan-600 dark:text-cyan-400">history_edu</span>
            <span>{doc.experience}</span>
          </div>

          <button
            type="button"
            data-open-booking-modal
            data-specialty={doc.specialite}
            class="w-full py-2.5 px-4 rounded-full bg-[#c6f7ff] dark:bg-cyan-400 hover:bg-[#b0f2fd] dark:hover:bg-cyan-300 text-[#0A2540] dark:text-slate-950 font-bold text-xs inline-flex items-center justify-center gap-1.5 transition-all shadow-sm hover:scale-[1.02] active:scale-[0.98] focus-visible:ring-2 focus-visible:ring-cyan-400 focus-visible:outline-none cursor-pointer"
          >
            <span class="material-symbols-outlined text-[15px]">calendar_month</span>
            <span>Prendre RDV</span>
          </button>
        </div>
      </div>
    ))}
  </div>
</section>
