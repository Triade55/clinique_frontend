---
// Institutional Trust, Accreditation & Metrics Strip
// In accordance with ui-ux-pro-max: Trust & Authority + Conversion pattern
---

<section class="relative z-20 -mt-8 max-w-7xl mx-auto px-4 md:px-8">
  <div class="reveal-scale glass-card-elevated rounded-3xl p-6 md:p-8 border border-[#c6f7ff] dark:border-cyan-900/50 shadow-xl backdrop-blur-2xl">
    <!-- Key Clinical Statistics -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 pb-8 border-b border-slate-200/80 dark:border-slate-800 text-center">
      <div class="space-y-1">
        <div class="font-headline text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#0A2540] dark:text-cyan-300">
          +12 500
        </div>
        <div class="font-body text-xs text-slate-500 dark:text-slate-400 font-medium">
          Patients soignés à Niangon
        </div>
      </div>

      <div class="space-y-1">
        <div class="font-headline text-2xl sm:text-3xl lg:text-4xl font-extrabold text-emerald-600 dark:text-emerald-400">
          99.4%
        </div>
        <div class="font-body text-xs text-slate-500 dark:text-slate-400 font-medium">
          Taux de satisfaction certifié
        </div>
      </div>

      <div class="space-y-1">
        <div class="font-headline text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#0A2540] dark:text-cyan-300">
          &lt; 10 min
        </div>
        <div class="font-body text-xs text-slate-500 dark:text-slate-400 font-medium">
          Délai moyen d'accueil d'urgence
        </div>
      </div>

      <div class="space-y-1">
        <div class="font-headline text-2xl sm:text-3xl lg:text-4xl font-extrabold text-rose-500">
          24h / 7j
        </div>
        <div class="font-body text-xs text-slate-500 dark:text-slate-400 font-medium">
          Permanence des soins non-stop
        </div>
      </div>
    </div>

    <!-- Institutional Accreditations & Insurance Partners -->
    <div class="pt-6">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-6">
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 sm:gap-6 text-xs text-slate-600 dark:text-slate-300">
          <!-- Trust badge 1 -->
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-100/90 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 font-semibold shadow-xs">
            <span class="material-symbols-outlined text-emerald-600 dark:text-emerald-400 text-[18px]">verified</span>
            <span>Agréé Ministère de la Santé (CI)</span>
          </div>

          <!-- Trust badge 2 -->
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-100/90 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 font-semibold shadow-xs">
            <span class="material-symbols-outlined text-cyan-600 dark:text-cyan-400 text-[18px]">medical_services</span>
            <span>Praticiens Inscrits à l'ONMCI</span>
          </div>

          <!-- Trust badge 3 -->
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-100/90 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 font-semibold shadow-xs">
            <span class="material-symbols-outlined text-blue-600 dark:text-blue-400 text-[18px]">shield</span>
            <span>Conventionné 15+ Assurances & Mutuelles</span>
          </div>
        </div>

        <!-- Mutual Insurance Pill Logotypes -->
        <div class="flex items-center gap-2 text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">
          <span class="hidden sm:inline">Mutuelles :</span>
          <span class="px-2.5 py-1 rounded-md bg-slate-200/70 dark:bg-slate-800 text-slate-700 dark:text-slate-300">MUGEF-CI</span>
          <span class="px-2.5 py-1 rounded-md bg-slate-200/70 dark:bg-slate-800 text-slate-700 dark:text-slate-300">ASCOMA</span>
          <span class="px-2.5 py-1 rounded-md bg-slate-200/70 dark:bg-slate-800 text-slate-700 dark:text-slate-300">SUNU</span>
          <span class="px-2.5 py-1 rounded-md bg-slate-200/70 dark:bg-slate-800 text-slate-700 dark:text-slate-300">SANLAM</span>
        </div>
      </div>
    </div>
  </div>
</section>
